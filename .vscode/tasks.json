{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "vite:dev",
      "type": "npm",
      "script": "dev",
      "isBackground": true,
      "problemMatcher": {
        "owner": "vite",
        "pattern": {
          "regexp": "^$"
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "VITE",
          "endsPattern": "ready in"
        }
      }
    },
    {
      "label": "vite:stop",
      "type": "shell",
      "command": "kill $(lsof -t -i:5173) 2>/dev/null; exit 0",
      "presentation": {
        "reveal": "silent",
        "close": true
      },
      "problemMatcher": []
    }
  ]
}
